FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_health_management
DB_USER=root
DB_PASSWORD=0603
# Optional: overrides the DB_* settings above (URL-encode the password).
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_health_management
# Managed MySQL providers (e.g. TiDB Cloud) require TLS:
# DB_SSL_CA=/etc/secrets/isrgrootx1.pem
# DB_SSL_REQUIRE=False
# DB_SSL_VERIFY=True
SESSION_COOKIE_SECURE=False

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://127.0.0.1:5000
OPENROUTER_APP_NAME=AI Health

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True
OTP_EXPIRY_SECONDS=300
