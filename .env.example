FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_health_management
DB_USER=root
DB_PASSWORD=0603
# Optional: overrides the DB_* settings above (URL-encode the password).
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_health_management
# Managed MySQL providers (e.g. TiDB Cloud) require TLS:
# DB_SSL_CA=/etc/secrets/isrgrootx1.pem
# DB_SSL_REQUIRE=False
# DB_SSL_VERIFY=True
SESSION_COOKIE_SECURE=False

# Any OpenAI-compatible provider works. Free options (no credit card).
# Only the key is required: leave the URL/model empty and they are inferred
# from the key prefix (gsk_ -> Groq, AIza -> Gemini, otherwise OpenRouter).
#   Groq:    OPENROUTER_BASE_URL=https://api.groq.com/openai/v1
#            OPENROUTER_MODEL=openai/gpt-oss-120b
#   Gemini:  OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#            OPENROUTER_MODEL=gemini-2.5-flash
#   OpenRouter: OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#            OPENROUTER_MODEL=<a model ending in :free>
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_SITE_URL=http://127.0.0.1:5000
OPENROUTER_APP_NAME=AI Health

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True
OTP_EXPIRY_SECONDS=300
